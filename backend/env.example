# Copy this file to ".env" in the same folder and fill in real values.
# NEVER commit the real ".env" file to GitHub.

# The ONE shared admin account for the hackathon team.
# On first server start, this account is created automatically (or updated)
# with role = "admin". Share these values with your two teammates privately
# (e.g. a private message) — do NOT put them in code or in the repo.
ADMIN_EMAIL=admin@signal.local
ADMIN_PASSWORD=change-this-before-running

# Secret used to sign login JWTs. Make this a long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Optional: Anthropic API key for AI triage (POST /api/triage and automatic
# triage on SOS creation). If this is left blank, SIGNAL automatically falls
# back to a simple keyword-based triage so the rest of the app still works.
AI_API_KEY=

# Port the backend listens on (optional, defaults to 3000)
PORT=3000

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). Example for VS Code Live Server default port:
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
